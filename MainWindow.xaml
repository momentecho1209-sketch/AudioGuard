<Window x:Class="AudioGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioGuard 設定" Width="480" Height="600"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 音量設定 -->
        <GroupBox Grid.Row="0" Header="音量設定">
            <StackPanel>
                <CheckBox x:Name="ChkMute" Content="新規プロセスをミュートにする" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="既定音量:" VerticalAlignment="Center" Width="80"/>
                    <Slider x:Name="SliderVolume" Width="250" Minimum="0" Maximum="100"
                            TickFrequency="5" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            ValueChanged="SliderVolume_ValueChanged"/>
                    <TextBlock x:Name="TxtVolumeLabel" Text="30%" VerticalAlignment="Center" Margin="8,0,0,0" Width="40"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 除外リスト -->
        <GroupBox Grid.Row="1" Header="除外リスト (音量調整しない exe)">
            <StackPanel>
                <ListBox x:Name="LstExcluded" Height="80" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TxtNewExclude" Width="250" Margin="0,0,4,0"
                             VerticalContentAlignment="Center"/>
                    <Button Content="追加" Click="BtnAddExclude_Click"/>
                    <Button Content="削除" Click="BtnRemoveExclude_Click"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 適用済みリスト -->
        <GroupBox Grid.Row="2" Header="適用済みプロセス (次回起動時は再適用しない)">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="LstApplied" Grid.Row="0" MinHeight="100"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="選択を削除 (再適用対象に戻す)" Click="BtnRemoveApplied_Click"/>
                    <Button Content="全クリア" Click="BtnClearApplied_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- その他 -->
        <GroupBox Grid.Row="3" Header="その他">
            <CheckBox x:Name="ChkAutoStart" Content="Windows 起動時に自動実行"/>
        </GroupBox>

        <!-- 保存ボタン -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,8,0">
            <Button Content="保存" Click="BtnSave_Click" IsDefault="True"/>
            <Button Content="閉じる" Click="BtnClose_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
